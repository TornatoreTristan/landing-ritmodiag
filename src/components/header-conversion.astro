---
// Bandeau d'accueil orienté conversion (pages Google Ads) : H1 court adapté au groupe d'annonces,
// note Google sous le titre, prix d'appel et formulaire court. Activé par le bloc "hero" d'une ville.
import { Image, type ImageMetadata } from 'astro:assets';
import GoogleAvis from './google-avis.astro';
import AvisMobile from './avis-mobile.astro';
import FormulaireAccueil from './formulaire-accueil.astro';

interface Avis {
  auteur: string
  note: number
  texte: string
  photo: string
}

interface Hero {
  h1: string
  h1_prix?: string
  h1_vente?: string
  h1_location?: string
  prix_dpe?: number
}

interface Props {
  ville: string
  avis: Avis[]
  slug: string
  telephone: string
  departements?: string
  headerImage?: ImageMetadata
  hero: Hero
}

const { ville, avis, slug, telephone, departements, headerImage, hero } = Astro.props

// Le texte avant la première virgule passe en couleur principale ("DPE et diagnostics à Angers", RDV sous 48 h)
function decouper(titre: string) {
  const i = titre.indexOf(',')
  return i === -1 ? [titre, ''] : [titre.slice(0, i), titre.slice(i)]
}
const [accent, suite] = decouper(hero.h1)
const variantes = Object.fromEntries(
  (['prix', 'vente', 'location'] as const)
    .filter((k) => hero[`h1_${k}`])
    .map((k) => [k, decouper(hero[`h1_${k}`]!)])
)

const puces = ['RDV en moins de 48 heures', 'Rapport livré sous 72 h', 'Diagnostiqueurs certifiés et expérimentés']
---

<section class="pt-6 pb-10 lg:py-10 overflow-x-clip">
  <div class="container-content grid grid-cols-1 lg:grid-cols-2 lg:grid-rows-[auto_1fr] gap-x-12 gap-y-6 lg:min-h-[calc(100vh-140px)] lg:content-center">
    <!-- Titre, note, prix -->
    <div class="min-w-0 flex flex-col gap-3 lg:col-start-1 lg:row-start-1 lg:self-end">
      {departements && <p class="text-gray-400 border-b border-gray-200 pb-2 text-sm">Intervention sur tout le {departements}</p>}
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">
        <span class="text-primary" id="hero-h1-accent">{accent}</span><span id="hero-h1-suite">{suite}</span>
      </h1>
      {Object.keys(variantes).length > 0 && (
        // Exécuté pendant le rendu, avant l'affichage : pas de changement visible du titre
        <script is:inline define:vars={{ variantes }}>
          var v = variantes[new URLSearchParams(location.search).get('angle')]
          if (v) {
            document.getElementById('hero-h1-accent').textContent = v[0]
            document.getElementById('hero-h1-suite').textContent = v[1]
          }
        </script>
      )}
      <div class="flex flex-wrap items-center gap-3 [&>div]:mt-0">
        <GoogleAvis />
        {hero.prix_dpe && (
          <p class="inline-flex items-baseline gap-1.5 bg-primary text-white rounded-2xl px-4 py-3">
            <span class="text-sm font-semibold">DPE dès</span>
            <span class="text-2xl font-bold leading-none">{hero.prix_dpe} €</span>
          </p>
        )}
      </div>
    </div>

    <!-- Formulaire (sur la photo en desktop) -->
    <div class="min-w-0 relative lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-stretch flex items-center">
      {headerImage && (
        <div class="hidden lg:block absolute inset-0 rounded-2xl overflow-hidden">
          <Image src={headerImage} alt={`Diagnostics immobiliers et DPE à ${ville}`} class="w-full h-full object-cover" widths={[768, 1024]} sizes="50vw" quality={75} loading="eager" fetchpriority="high" />
          <div class="absolute inset-0 bg-dark/20"></div>
        </div>
      )}
      <div class="relative w-full lg:max-w-sm lg:mx-auto lg:my-10">
        <FormulaireAccueil ville={ville} telephone={telephone} slug={slug} />
      </div>
    </div>

    <!-- Réassurance -->
    <div class="min-w-0 flex flex-col gap-5 lg:col-start-1 lg:row-start-2 lg:self-start">
      <p class="text-base lg:text-lg text-gray-500">
        DPE, diagnostics vente et location, audits énergétiques : un diagnostiqueur certifié de {ville} vous accompagne et vous explique chaque résultat.
      </p>
      <ul class="flex flex-col gap-2.5" role="list">
        {puces.map((p) => (
          <li class="flex items-center gap-2.5 font-semibold text-sm sm:text-base">
            <span class="text-primary shrink-0" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            </span>
            {p}
          </li>
        ))}
      </ul>
      <AvisMobile avis={avis} />
    </div>
  </div>
</section>
